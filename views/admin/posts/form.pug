extends ../../common/layout

block layout-content
  h1.mb-3 #{title}

  if error
    .alert.alert-danger #{error}

  form(method="post", enctype="multipart/form-data" action=formAction)
    if post._id
      input(type="hidden", name="id", value=post._id)

    .mb-3
      label.form-label(for="userId") User
      select.form-select(id="userId", name="userId", required)
        option(value="") -- Select user --
        each user in users
          option(
            value=user._id,
            selected=post.userId && String(post.userId) === String(user._id)
          ) #{user.fullName} (#{user.username})

    .mb-3
      label.form-label(for="photo") Photo
      input.form-control(type="file", id="photo", name="photo", accept="image/*")

    if post.photo
      .mb-3
        label.form-label Existing Photo : 
        img(
            class="post-photo"
            src=`data:${post.photoType};base64,${post.photo.toString('base64')}`
            alt="Photo"
        )
    else
        span.text-muted No image

    .mb-3
      label.form-label(for="restaurantName") Restaurant Name
      input.form-control(type="text", id="restaurantName", name="restaurantName", required, value=post.restaurantName || "")

    .mb-3
      label.form-label(for="restaurantStreetName") Street Name
      input.form-control(type="text", id="restaurantStreetName", name="restaurantStreetName", required, value=post.restaurantStreetName || "")

    .mb-3
      label.form-label(for="restaurantCity") City
      input.form-control(type="text", id="restaurantCity", name="restaurantCity", required, value=post.restaurantCity || "")

    .mb-3
      label.form-label(for="restaurantProvince") Province
      input.form-control(type="text", id="restaurantProvince", name="restaurantProvince", required, value=post.restaurantProvince || "")

    .mb-3
      label.form-label(for="restaurantCountry") Country
      input.form-control(type="text", id="restaurantCountry", name="restaurantCountry", required, value=post.restaurantCountry || "")

    .mb-3
      label.form-label(for="restaurantPostalCode") Postal Code
      input.form-control(type="text", id="restaurantPostalCode", name="restaurantPostalCode", required, value=post.restaurantPostalCode || "")

    .mb-3
      label.form-label(for="dishName") Dish Name
      input.form-control(type="text", id="dishName", name="dishName", required, value=post.dishName || "")

    .mb-3
      label.form-label(for="comment") Comment
      textarea.form-control(id="comment", name="comment", rows="3")= post.comment || ""

    .mb-3
      label.form-label(for="rating") Rating
      input.form-control(type="number", id="rating", name="rating", min="1", max="5", value=post.rating || "")

    button.btn.btn-primary(type="submit") Save
    a.btn.btn-secondary.ms-2(href="/admin/posts") Cancel